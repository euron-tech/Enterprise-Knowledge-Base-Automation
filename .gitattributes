# Normalize line endings so Windows/Linux/CI agree on file contents.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary — never diff or normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.mp3  binary
*.mp4  binary
*.zip  binary
*.tar.gz binary

# Lockfiles: keep out of diffs, still versioned
package-lock.json -diff
uv.lock           -diff
poetry.lock       -diff
