# ─────────────────────────────────────────────────────────────
# Secrets — NEVER commit. See .claude/rules/00-root.md §2
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
/secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
kubeconfig
*.kubeconfig
.aws/
/credentials

# Terraform — state and variable files carry secrets
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraform/
# .terraform.lock.hcl is intentionally COMMITTED: it pins provider versions
crash.log
crash.*.log
tfplan
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

