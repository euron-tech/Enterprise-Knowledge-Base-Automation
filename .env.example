# Copy to .env and fill in. NEVER commit .env.
# Values are seeded into AWS Secrets Manager by scripts/seed_secrets.py (create/update only).

ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=52428800

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./ekba.db
# prod: postgresql+asyncpg://user:pass@host:5432/ekba

# --- Redis (cache + rate limiting) ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# --- Qdrant ---
QDRANT_URL=:memory:
QDRANT_COLLECTION=ekba_chunks_dev

# --- Euri AI Gateway ---
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_API_KEY=replace-me
EURI_EMBEDDING_MODEL=gemini-embedding-2-preview
EURI_EMBEDDING_DIMENSIONS=1536
EURI_GENERATION_MODEL=gpt-4.1
EURI_PLANNER_MODEL=gpt-4.1-mini
EURI_FALLBACK_MODEL=gpt-4.1-mini
EURI_VISION_MODEL=gpt-4.1
EURI_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- Cognito ---
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=replace-me
COGNITO_CLIENT_ID=replace-me
AUTH_DEV_MODE=true          # dev only: accept locally signed test tokens

# --- S3 ---
S3_BUCKET_DOCUMENTS=ekba-dev-documents
S3_BUCKET_DERIVED=ekba-dev-derived
AWS_REGION=ap-south-1

# --- Agent budgets (code-enforced) ---
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_CALLS_PER_TOOL=4
AGENT_MAX_CONTEXT_CHUNKS=40
AGENT_MAX_TOKENS=60000
AGENT_WALL_CLOCK_SECONDS=45

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RELEVANCE_THRESHOLD=0.35
MAX_CHUNK_TOKENS=1500
